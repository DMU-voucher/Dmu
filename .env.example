# Only the hosted copy needs this file. The office machine runs from run.bat and
# needs none of it.
#
# On the server: copy this to `.env` in the same folder, fill it in, then press
# Reload in PythonAnywhere's Web tab. `.env` is gitignored and must never be
# committed, because it holds the password.

# The password for the whole site. One browser prompt in front of every page.
# Without it the app refuses to serve anything, because an open copy prints DMU
# vouchers for anyone who finds the address.
#
# The sign-in box asks for a username as well, because that is what browser
# authentication is. It is not checked. Type anything in it.
DMU_SITE_PASSWORD=

# Where the finished batches and the uploaded CSVs live. Must be OUTSIDE this
# folder, or deploying a new version deletes them. Left out, it is
# ~/dmu-voucher-data.
# DMU_DATA_DIR=/home/YOURNAME/dmu-voucher-data

# Which engine draws the PDFs. wsgi.py already forces weasyprint, because
# Chromium is 427 MB against a free account's 512 MB. Only set this to compare
# the two on a machine that has both.
# DMU_PDF_ENGINE=weasyprint
