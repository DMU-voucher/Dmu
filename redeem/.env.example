# Copy this file to .env and fill it in, or set the same names as environment
# variables. .env is gitignored and must never be committed: it holds the
# passwords the vendors and DMU Venues use.
#
# On PythonAnywhere these go under Web, then Environment variables, which
# survives a redeploy and keeps them out of the repository entirely.

# What the vendors are told at the venue. Change it if a member of staff leaves.
DMU_VENDOR_PASSWORD=

# For DMU Venues, to import batches and reconcile. Not the same as above.
DMU_ADMIN_PASSWORD=

# Signs the session cookie. Any long random string. Changing it signs everyone
# out, which is harmless. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
DMU_SECRET_KEY=

# Where the database lives. On PythonAnywhere point this somewhere outside the
# repository folder so a redeploy cannot wipe the redemptions, for example
#   /home/YOURNAME/dmu-voucher-data/redemptions.db
# DMU_DB_PATH=

# The venue names offered at sign-in, separated by |. These must match what is
# printed on the vouchers.
# DMU_VENUES=Saints of Mokha|Devorer Street Vendor (outside Monty's)
